# Briefnest website configuration.
#
# Copy to .env.local for local work, or set these in your host's dashboard. Every value is public: it ends up in
# the built pages. There are no secrets here. All of them are optional; with none set the site builds as the real
# one: at the address in src/content/site.ts, offering the build recorded in src/content/release.ts.
#
# They are read when the site is built. On Cloudflare, set them as build variables (the Worker's Settings > Build >
# Build variables and secrets), not as runtime variables.

# --- Where the site lives ---------------------------------------------------------------------------------
# The site's address is recorded in src/content/site.ts (https://ability.ninja) and needs nothing here. Set this
# only for a copy served somewhere else: its origin, without a trailing slash. It is used for canonical URLs, the
# sitemap, robots.txt and social previews.
# NEXT_PUBLIC_SITE_URL=https://example.com

# --- The download -----------------------------------------------------------------------------------------
# The published build is recorded in src/content/release.ts and needs nothing here. Set these only for a host
# that should offer a different file; together they replace that record entirely. Set NEXT_PUBLIC_DOWNLOAD_URL
# only when a build is really published at that address (a GitHub Release asset, object storage, a CDN). Never
# commit the DMG to this repository.
# NEXT_PUBLIC_DOWNLOAD_URL=https://downloads.example.com/Briefnest-0.2.0-arm64.dmg

# Required with a download URL. The moment the build stops working, as printed by
# scripts/build-production-dmg.sh, or "never" for a build that doesn't expire. The site shows this date.
# NEXT_PUBLIC_DOWNLOAD_EXPIRES=2026-12-25T17:15:19Z

# Optional label: release, beta or time-limited. Defaults to time-limited when the build expires, else release.
# NEXT_PUBLIC_DOWNLOAD_CHANNEL=time-limited

# Optional details shown beside the button.
# NEXT_PUBLIC_DOWNLOAD_SHA256=<64 hex characters, from `shasum -a 256 Briefnest-0.2.0-arm64.dmg`>
# NEXT_PUBLIC_DOWNLOAD_SIZE_BYTES=70827519
# NEXT_PUBLIC_DOWNLOAD_RELEASED=2026-11-26

# The version shown across the site. Defaults to the version in src/content/release.ts.
# NEXT_PUBLIC_RELEASE_VERSION=0.2.0

# --- Early access, while there is no public download ------------------------------------------------------
# An HTTPS endpoint that accepts a JSON POST: { "email", "consent": true, "source": "briefnest-website" }.
# Formspree, Basin, Getform or your own function all work. When set, the download page shows a request form.
# NEXT_PUBLIC_WAITLIST_ENDPOINT=https://formspree.io/f/your-form-id

# Or simply an address people can write to. Shown as a mailto link when no endpoint is set.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# --- Optional ---------------------------------------------------------------------------------------------
# A public source link for the footer. Leave unset while the repository is private.
# NEXT_PUBLIC_REPOSITORY_URL=https://github.com/your-org/briefnest
