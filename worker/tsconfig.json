{
  // The film handler runs on Cloudflare Workers, not in a browser or in Node.js, so it is checked on its own
  // against the Workers runtime types that `wrangler types` writes to worker-configuration.d.ts.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["./worker-configuration.d.ts"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["*.ts"]
}
